# Copy this file to ".env" (same folder) and fill in your own GSC account.
# ".env" is listed in .gitignore, so it is never committed - only this
# example template (with no real values) is tracked in git.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
#
# Then edit .env and replace the placeholders below with your real mobile
# number and password. Playwright will pick them up automatically on every
# run - no need to set environment variables by hand anymore.

GSC_TEST_MOBILE_NUMBER=
GSC_TEST_PASSWORD=
